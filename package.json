{
  "name": "dsh-session-span",
  "version": "1.0.3",
  "description": "在侧边栏会话行的悬停卡片中显示会话的已用时长与起始时间 / Session elapsed time and start time in the sidebar hover card.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "aNoWhale",
    "url": "https://github.com/aNoWhale"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "elapsed-time"
  ],
  "homepage": "https://github.com/aNoWhale/dsh-session-span#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aNoWhale/dsh-session-span.git"
  },
  "bugs": {
    "url": "https://github.com/aNoWhale/dsh-session-span/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
