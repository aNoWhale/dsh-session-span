{
  "name": "dsh-session-span",
  "version": "0.1.0",
  "description": "Shows how long a Session has been running since its first message, in the sidebar Session hover card.",
  "type": "module",
  "license": "MIT",
  "author": "cks <940962289@qq.com>",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "elapsed-time"
  ],
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
